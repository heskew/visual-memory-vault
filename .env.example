# ==============================================================================
# Visual Memory Vault - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini / Vertex AI Configuration
# ------------------------------------------------------------------------------
# Option A: Direct Google AI Studio Gemini API Key (Recommended for local dev)
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: Google Cloud Vertex AI (For GCP deployments / reasoning engines)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# Harper / FLAIR Memory Configuration
# ------------------------------------------------------------------------------
# Target URL for the FLAIR memory daemon or Harper Fabric instance
FLAIR_URL=http://127.0.0.1:19926

# Agent ID / Principal namespace in FLAIR
FLAIR_AGENT_ID=visual-memory-vault

# Path to the agent's Ed25519 private key file
FLAIR_KEYFILE=~/.flair/keys/visual-memory-vault.key

# Alternatively, pass the raw base64-encoded private key in container environments:
# FLAIR_PRIVATE_KEY_B64=

# ------------------------------------------------------------------------------
# Frontend & Ingestion Proxy Configuration
# ------------------------------------------------------------------------------
# Shared secret guarding /upload, /jobs, /media, /chat, and /ingest
# (e.g. for iOS Shortcuts or mobile capture).
# REQUIRED for a deployed proxy: with no key set the proxy fails closed (503)
# unless ALLOW_UNAUTHENTICATED=1 is set below.
# PROXY_API_KEY=your-custom-proxy-token

# Local dev only: open the proxy when no PROXY_API_KEY is configured.
# Never set this on a deployed or public service.
# ALLOW_UNAUTHENTICATED=1

# Local directory for cached images and job records (dev / process restart)
# MEDIA_DIR=/tmp/visual-memory-vault/media

# Existing GCS bucket for durable images + job records across Cloud Run scale-to-zero
# GCS_BUCKET_NAME=

# Production worker: Cloud Tasks allocates CPU for a new POST /ingest request.
# Set the queue and your already-deployed proxy base (do not invent a URL).
# CLOUD_TASKS_QUEUE=
# CLOUD_TASKS_LOCATION=
# CLOUD_TASKS_PROJECT=
# INGEST_HANDLER_URL=
# INGEST_TASKS_OIDC_SA=

# Local uvicorn only. Leave 0 in production — Cloud Tasks is the worker.
# INGEST_DRAIN_INTERVAL_SEC=15

